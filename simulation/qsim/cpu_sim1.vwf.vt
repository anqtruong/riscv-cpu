`timescale 1 ps/ 1 ps
module cpu_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg rst;
// wires                                               
wire [39:0] inst_name;
wire [31:0] inst_sim;
wire [31:0] pc_sim;
wire [31:0] result_sim;

// assign statements (if any)                          
cpu i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.inst_name(inst_name),
	.inst_sim(inst_sim),
	.pc_sim(pc_sim),
	.result_sim(result_sim),
	.rst(rst)
);
initial 
begin 
#1000000 $finish;
end 

// rst
initial
begin
	rst = 1'b1;
	rst = #40000 1'b0;
end 

// clk
always
begin
	clk = 1'b0;
	clk = #10000 1'b1;
	#10000;
end 
endmodule

